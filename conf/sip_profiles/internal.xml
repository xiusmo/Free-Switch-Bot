<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<profile name="internal">
  <aliases>
    <alias name="default"/>
  </aliases>
  <gateways>
    <gateway name="ucm_trunk">
      <param name="proxy" value="$${ucm_ip}:5060"/>
      <param name="register" value="false"/>
      <param name="extension" value=""/>
      <param name="caller-id-in-from" value="true"/>
      <param name="from-user" value="1000"/>
      <param name="from-domain" value="$${ucm_ip}"/>
      <param name="ping" value="0"/>
      <param name="context" value="default"/>
      <param name="expire-seconds" value="3600"/>
      <param name="retry-seconds" value="30"/>
      <param name="profile" value="internal"/>
    </gateway>
  </gateways>
  <domains>
    <domain name="all" alias="false" parse="true"/>
  </domains>
  <settings>
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>
    <param name="sip-capture" value="no"/>
    
    <param name="rfc2833-pt" value="101"/>
    <param name="sip-port" value="$${internal_sip_port}"/>
    <param name="dialplan" value="XML"/>
    <param name="context" value="default"/>
    <param name="dtmf-duration" value="200"/>
    <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
    <param name="outbound-codec-prefs" value="$${outbound_codec_prefs}"/>
    
    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-ip" value="0.0.0.0"/>
    <param name="sip-ip" value="0.0.0.0"/>
    <param name="hold-music" value="$${hold_music}"/>
    <param name="apply-nat-acl" value="nat.auto"/>
    <param name="apply-inbound-acl" value="internal"/>
    
    <param name="manage-presence" value="false"/>
    <param name="presence-hosts" value="$${domain_name}"/>
    <param name="presence-privacy" value="$${presence_privacy}"/>
    
    <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>
    <param name="ext-sip-ip" value="$${external_sip_ip}"/>
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    
    <!-- NAT处理 -->
    <param name="force-register-domain" value="$${domain_name}"/>
    <param name="force-subscription-domain" value="$${domain_name}"/>
    <param name="force-register-db-domain" value="$${domain_name}"/>
    
    <!-- AI相关设置 -->
    <param name="record-template" value="$${recordings_dir}/${domain_name}/archive/${strftime(%Y-%m-%d-%H-%M-%S)}.${destination_number}.${caller_id_number}.${uuid}.wav"/>
  </settings>
</profile> 