<document type="freeswitch/xml">
  <!-- 网络配置 -->
  
  <!-- SIP配置 -->
  
  <!-- RTP配置 -->
  
  <!-- 音频配置 -->
  
  <!-- ESL配置 -->
  
  <!-- 域名配置 -->
  
  <!-- 录音配置 -->
  
  <!-- UCM对接IP -->
  
  <section name="configuration" description="Various Configuration">
<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <list name="domains" default="deny">
      <node type="allow" domain="127.0.0.1"/>
      <node type="allow" domain="127.0.0.1"/>
    </list>

    <list name="loopback.auto" default="deny">
      <node type="allow" cidr="127.0.0.0/8"/>
      <node type="allow" cidr="::1/128"/>
    </list>

    <list name="lan" default="deny">
      <node type="allow" cidr="auto/32"/>
    </list>

    <list name="rfc1918.auto" default="deny">
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
    </list>

    <list name="localnet.auto" default="deny">
      <node type="allow" cidr="169.254.0.0/16"/>
      <node type="allow" cidr="192.0.2.0/24"/>
      <node type="allow" cidr="198.18.0.0/15"/>
      <node type="allow" cidr="198.51.100.0/24"/>
      <node type="allow" cidr="203.0.113.0/24"/>
    </list>

    <list name="nat.auto" default="deny">
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
      <node type="allow" cidr="100.64.0.0/10"/>
    </list>

    <list name="internal" default="deny">
      <node type="allow" cidr="127.0.0.1/32"/>
      <node type="allow" cidr="172.16.100.101/32"/>
    </list>
  </network-lists>
</configuration> <configuration name="event_socket.conf" description="Socket Client">
  <load module="mod_event_socket"/>
  <settings>
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="FSB0t_3SL_pw_20250812_abcDEF1234"/>
    <!-- 开发环境放宽：允许所有 IPv4 访问（仅限容器网络使用，生产请收紧） -->
    <param name="apply-inbound-acl" value="any_v4.auto"/>
  </settings>
</configuration> <configuration name="mod_audio_stream.conf" description="Audio Stream to WebSocket">
  <load module="mod_audio_stream"/>
  <settings>
    <param name="websocket-enabled" value="true"/>
    <param name="websocket-port" value="8081"/>
    <param name="sample-rate" value="8000"/>
    <param name="channels" value="1"/>
    <param name="bit-depth" value="16"/>
    <param name="buffer-size" value="1024"/>
    <param name="max-connections" value="100"/>
  </settings>
</configuration> <configuration name="modules.conf" description="Modules">
  <modules>
    <!-- Core utilities -->
    <load module="mod_logfile"/>
    <load module="mod_hash"/>
    <load module="mod_commands"/>
    <load module="mod_dptools"/>
    <load module="mod_expr"/>
    <load module="mod_spandsp"/>

    <!-- Event Socket -->
    <load module="mod_event_socket"/>

    <!-- File and media -->
    <load module="mod_sndfile"/>
    <load module="mod_native_file"/>
    <load module="mod_tone_stream"/>

    <!-- SIP stack -->
    <load module="mod_sofia"/>

    <!-- Loopback (useful for tests) -->
    <load module="mod_loopback"/>

    <!-- Audio stream (WebSocket) -->
    <load module="mod_audio_stream"/>
  </modules>
</configuration>
<configuration name="sofia.conf" description="sofia Configuration">
  <global_settings>
    <param name="log-level" value="0"/>
    <param name="abort-on-empty-external-ip" value="true"/>
    <param name="auto-restart" value="false"/>
    <param name="debug-presence" value="0"/>
    <!-- <param name="capture-server" value="udp:homer.domain.com:9060"/> -->
  </global_settings>

  <!--
  The rabbit hole goes deep.  This includes all the
  profiles in the sip_profiles directory that is up
  one level from this directory.
  -->
  <profiles>
<profile name="internal">
  <aliases>
    <alias name="default"/>
  </aliases>
  <gateways>
    <gateway name="ucm_trunk">
      <param name="proxy" value="172.16.100.101:5060"/>
      <param name="register" value="false"/>
      <param name="extension" value=""/>
      <param name="caller-id-in-from" value="true"/>
      <param name="from-user" value="1000"/>
      <param name="from-domain" value="172.16.100.101"/>
      <param name="ping" value="0"/>
      <param name="context" value="default"/>
      <param name="expire-seconds" value="3600"/>
      <param name="retry-seconds" value="30"/>
      <param name="profile" value="internal"/>
    </gateway>
  </gateways>
  <domains>
    <domain name="all" alias="false" parse="true"/>
  </domains>
  <settings>
    <param name="debug" value="0"/>
    <param name="sip-trace" value="no"/>
    <param name="sip-capture" value="no"/>
    
    <param name="rfc2833-pt" value="101"/>
    <param name="sip-port" value="5060"/>
    <param name="dialplan" value="XML"/>
    <param name="context" value="default"/>
    <param name="dtmf-duration" value="200"/>
    <param name="inbound-codec-prefs" value="OPUS,G722,PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="OPUS,G722,PCMU,PCMA"/>
    
    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-ip" value="0.0.0.0"/>
    <param name="sip-ip" value="0.0.0.0"/>
    <param name="hold-music" value=""/>
    <param name="apply-nat-acl" value="nat.auto"/>
    <param name="apply-inbound-acl" value="internal"/>
    
    <param name="manage-presence" value="false"/>
    <param name="presence-hosts" value="127.0.0.1"/>
    <param name="presence-privacy" value=""/>
    
    <param name="ext-rtp-ip" value="172.16.100.105"/>
    <param name="ext-sip-ip" value="172.16.100.105"/>
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    
    <!-- NAT处理 -->
    <param name="force-register-domain" value="127.0.0.1"/>
    <param name="force-subscription-domain" value="127.0.0.1"/>
    <param name="force-register-db-domain" value="127.0.0.1"/>
    
    <!-- AI相关设置 -->
    <param name="record-template" value="/recordings/${domain_name}/archive/${strftime(%Y-%m-%d-%H-%M-%S)}.${destination_number}.${caller_id_number}.${uuid}.wav"/>
  </settings>
</profile>   </profiles>

</configuration> <configuration name="switch.conf" description="Core Configuration">
  <settings>
    <param name="max-sessions" value="1000"/>
    <param name="sessions-per-second" value="30"/>
    <param name="colorize-console" value="true"/>
  </settings>
</configuration>
  </section>

  <section name="dialplan" description="Regex/XML Dialplan">
  <context name="default">
    <!-- Outbound to UCM: dial 9 + number to send via ucm_trunk -->
    <extension name="to_ucm" continue="false">
      <condition field="destination_number" expression="^9(\d+)$">
        <action application="set" data="effective_caller_id_number=${caller_id_number}"/>
        <action application="bridge" data="sofia/gateway/ucm_trunk/${1}"/>
      </condition>
    </extension>

    <!-- Direct dial UCM extension 1001 via ucm_trunk -->
    <extension name="to_ucm_ext_1001" continue="false">
      <condition field="destination_number" expression="^(1001)$">
        <action application="set" data="effective_caller_id_number=${caller_id_number}"/>
        <action application="bridge" data="sofia/gateway/ucm_trunk/${1}"/>
      </condition>
    </extension>
    <!-- Simple test extension - just answers with success message -->
    <extension name="simple_test">
      <condition field="destination_number" expression="^(9999)$">
        <action application="answer"/>
        <action application="sleep" data="1000"/>
        <action application="playback" data="tone_stream://%(1000,0,1000)"/>
        <action application="sleep" data="5000"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- Extension for testing audio stream -->
    <extension name="audio_stream_test">
      <condition field="destination_number" expression="^(1000)$">
        <action application="answer"/>
        <action application="playback" data="silence_stream://1000"/>
        <action application="record_session" data="/tmp/test_recording.wav"/>
        <action application="echo"/>
      </condition>
    </extension>
    
    <!-- Extension for echo test (renamed to avoid conflict with UCM 1001) -->
    <extension name="echo_test">
      <condition field="destination_number" expression="^(6001)$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>
    
    <!-- Extension for audio playback test -->
    <extension name="audio_playback_test">
      <condition field="destination_number" expression="^(1002)$">
        <action application="answer"/>
        <action application="playback" data="/var/lib/freeswitch/recordings/wav-example.wav"/>
        <action application="echo"/>
      </condition>
    </extension>
    
    <!-- Extension for recording test -->
    <extension name="recording_test">
      <condition field="destination_number" expression="^(1003)$">
        <action application="answer"/>
        <action application="record_session" data="/tmp/recording_test.wav"/>
        <action application="playback" data="silence_stream://5000"/>
        <action application="hangup"/>
      </condition>
    </extension>
  </context>
  </section>

  <section name="chatplan" description="Regex/XML Chatplan">
  </section>

  <section name="directory" description="User Directory">
  </section>

  <section name="phrases" description="Speech Phrase Management">
  </section>
</document> 